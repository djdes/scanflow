        [{
            \"relation\": [\"delegate_permission/common.handle_all_urls\"],
            \"target\": {\"namespace\": \"web\", \"site\": \"https://scanflow.ru\"}
        }]
    </string>
    <!-- Тот же share_target, что в public/site.webmanifest. -->
    <string name="share_target" translatable="false">
        {
            \"action\": \"/m/share\",
            \"method\": \"POST\",
            \"enctype\": \"multipart/form-data\",
            \"params\": {
                \"title\": \"title\",
                \"text\": \"text\",
                \"files\": [{
                    \"name\": \"files\",
                    \"accept\": [\"image/*\", \"application/pdf\", \"text/xml\", \"application/xml\"]
                }]
            }
        }
    </string>
</resources>
