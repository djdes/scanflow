<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ScanFlow</string>
    <string name="launch_url" translatable="false">https://scanflow.ru/m/</string>
    <!-- Связь с сайтом: вторая половина — /.well-known/assetlinks.json на scanflow.ru. -->
