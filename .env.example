# =============================================================================
# Runtime config (.env)
# =============================================================================
# Этот файл — статика на старте процесса. Поведение распознавания (режим
# 'hybrid' vs 'claude_api', выбор Claude-модели, llm_mapper_enabled) живёт
# в таблице analyzer_config (MariaDB) и меняется через UI:
#   GET  /api/settings   — текущие значения
#   POST /api/settings   — обновить (см. src/api/routes/settings.ts)
# Дефолт после миграций — mode='hybrid', claude_model='claude-sonnet-4-6'.
# Реально на проде используется mode='claude_api' (image → Anthropic API
# одним вызовом, без Google Vision).
# =============================================================================


# OCR fallback-цепочка для hybrid-режима (через запятую, без пробелов).
# В режиме claude_api эта цепочка не вызывается.
OCR_CHAIN=google_vision,tesseract

# Включает hybrid-режим (Google Vision OCR → Claude API для структуризации
# распознанного текста). В режиме mode='claude_api' игнорируется.
USE_CLAUDE_ANALYZER=true

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Anthropic API. Используется как fallback, если в analyzer_config.anthropic_api_key
# в БД ничего не задано. Хранить здесь продовский ключ — плохая идея, лучше
# задавать через UI Settings.
ANTHROPIC_API_KEY=sk-ant-api03-...

# HTTP прокси для Anthropic API (нужен только на проде, локально — не задавай).
ANTHROPIC_PROXY_URL=

# Пути
INBOX_DIR=./data/inbox
PROCESSED_DIR=./data/processed
FAILED_DIR=./data/failed

# =============================================================================
# MariaDB / MySQL
# =============================================================================
# Один инстанс MariaDB на проде используется и приложением, и локальной
# разработкой. Локально БД не поднимается — npm run dev подключается к тому
# же серверу через LAN. Удалённый доступ для пользователя scanflow должен
# быть включён на сервере.
DB_HOST=192.168.33.3
DB_PORT=3306
DB_USER=scanflow
DB_PASSWORD=
DB_NAME=scanflow

# API
API_PORT=8899
API_KEY=your-secret-api-key

# Webhook 1С
WEBHOOK_1C_URL=http://server:8080/invoice_exchange/hs/invoices
WEBHOOK_1C_TOKEN=token-for-1c
WEBHOOK_ENABLED=false

# Debug
DEBUG=false
# Принудительный движок OCR (google_vision, tesseract). Перебивает OCR_CHAIN
# и обходит роутер по analyzer_config.mode — для отладки.
OCR_FORCE_ENGINE=
LOG_LEVEL=info
DRY_RUN=false

# =============================================================================
# Email (SMTP) — ОПЦИОНАЛЬНО
# =============================================================================
# Используется ТОЛЬКО для системных писем (uncaughtException, диск-монитор).
# Для пользовательских уведомлений используется Telegram (см. /api/profile в
# дашборде, поля Chat ID и Bot Token). Если SMTP_* пусты — системные письма
# не идут (но программа работает нормально). MAIL_TO — fallback-адрес для
# системных писем.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# =============================================================================
# Sber Business API
# =============================================================================
# Регистрация на developers.sber.ru → сервис B2BSaaS. Для production scope:
#   openid GET_CLIENT_ACCOUNTS PAY_DOC_RU
# Сертификаты (.p12 + sber-ca.pem) кладутся в ./certs/ (не в git).
# Платёжное поручение создаётся в статусе черновика — пользователь подписывает
# в самом СберБизнес.
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=
SBER_REDIRECT_URI=https://scanflow.ru/api/sber/callback
SBER_TLS_PFX=./certs/sber.p12
SBER_TLS_PFX_PASSWORD=
SBER_CA_CERT=./certs/sber-ca.pem

# Порог «нет счёта в Сбер N дней»: платёжеспособная накладная без платежа дольше
# этого срока подсвечивается в списке и один раз шлёт оповещение (email + Telegram).
# По умолчанию 14.
SBER_OVERDUE_DAYS=14

# JWT-секрет для подписи OAuth state. Должно быть ≥32 символов.
JWT_SECRET=

# DaData (опционально). Без этого ключа кнопка "Заполнить по ИНН" в UI скрыта.
DADATA_API_KEY=

# Optional product assistants: allowed server origins, comma-separated.
# Each company configures its own API prefix and token in Profile.
# Example for MAG chef: http://192.168.33.214:18091 (LAN), http://10.9.1.3:18091 (VPN).
# SUB chef, company 3: http://127.0.0.1:18092 when backend runs on BSQL;
# from another server use http://10.9.1.3:18092 via VPN.
# PRODUCT_ASSISTANT_ALLOWED_ORIGINS=
# Requires JWT_SECRET (at least 32 chars) to encrypt saved tokens.
# Contract: docs/product-assistant-api.md

# Dispatcher mode (analyzer_config.mode='dispatcher'). Если хотите,
# чтобы OCR шёл через ProjectsFlow + вашу Claude Code Max-сессию вместо
# Anthropic API — заполнить три переменные. См. docs/dispatcher-runner.md.
PUBLIC_BASE_URL=https://scanflow.ru
PROJECTSFLOW_API_URL=https://projectsflow.ru/api
PROJECTSFLOW_AGENT_TOKEN=
PROJECTSFLOW_SCANFLOW_PROJECT_ID=55d1d6c5-0f0f-4ece-9d5a-cdf419e52c85
# Источники статистики 1С MCP: JSON с явным id владельца → url/token.
# Пример структуры без секретов: {"3":{"url":"http://onec-host:6003/mcp","token":"..."}}
# Не подключайте одну базу по умолчанию ко всем компаниям.
ONEC_USAGE_MCP_CONFIG=

# =============================================================================
# Правовые документы сайта (/privacy, /consent, /terms)
# =============================================================================
# Реквизиты оператора персональных данных подставляются в документы на сервере
# (src/legal/documents.ts). Пока LEGAL_OPERATOR_NAME пуст, документы говорят
# «реквизиты — по запросу», а в логе одно предупреждение. Наименование пишется
# в именительном падеже: «ИП Иванов Иван Иванович» / «ООО «Ромашка»».
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
# ОГРН (13 цифр) или ОГРНИП (15 цифр) — подпись выбирается по длине.
LEGAL_OPERATOR_OGRN=
LEGAL_OPERATOR_ADDRESS=
# Почта для запросов субъектов ПДн и претензий. По умолчанию hi@scanflow.ru.
LEGAL_CONTACT_EMAIL=

# =============================================================================
# Яндекс Метрика на сайте (главная, блог, правовые документы)
# =============================================================================
# Номер счётчика. Пусто — на сайте нет ни счётчика, ни сообщения о cookie.
# Счётчик загружается только после «Принять» в сообщении о cookie; Вебвизор
# выключен. Цели (JavaScript-события) заводятся в интерфейсе Метрики —
# список в CLAUDE.md, правило 46.
YANDEX_METRIKA_ID=
# 1 — A/B-проверка заголовка главной: половина посетителей видит вариант «b»,
# вариант уходит в Метрику параметром визита hero_variant. Без счётчика не
# включается.
SITE_HERO_AB=
