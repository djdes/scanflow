<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:form="http://v8.1c.ru/8.2/managed-application/form" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<title>
		<v8:item>
			<v8:lang>ru</v8:lang>
			<v8:content>Загрузка накладных со сканера</v8:content>
		</v8:item>
	</title>
	<AutoCommandBar name="ФормаКоманднаяПанель" id="-1">
		<AutoFill>false</AutoFill>
	</AutoCommandBar>
	<ChildItems>
		<InputField name="КодПодключения" id="10">
			<DataPath>КодПодключения</DataPath>
			<ContextMenu name="КодПодключенияКонтекстноеМеню" id="11">
				<AutoFill>true</AutoFill>
			</ContextMenu>
			<ExtendedTooltip name="КодПодключенияРасширеннаяПодсказка" id="12"/>
		</InputField>
		<Button name="ПодключитьПоКоду" id="13">
			<Type>UsualButton</Type>
			<CommandName>Form.Command.ПодключитьПоКоду</CommandName>
			<ExtendedTooltip name="ПодключитьПоКодуРасширеннаяПодсказка" id="14"/>
		</Button>
		<InputField name="ТокенПодключения" id="5">
			<DataPath>ТокенПодключения</DataPath>
			<PasswordMode>true</PasswordMode>
			<ContextMenu name="ТокенПодключенияКонтекстноеМеню" id="6">
				<AutoFill>true</AutoFill>
			</ContextMenu>
			<ExtendedTooltip name="ТокенПодключенияРасширеннаяПодсказка" id="7"/>
		</InputField>
		<Button name="СохранитьПодключение" id="8">
			<Type>UsualButton</Type>
			<CommandName>Form.Command.СохранитьПодключение</CommandName>
			<ExtendedTooltip name="СохранитьПодключениеРасширеннаяПодсказка" id="9"/>
		</Button>
		<Button name="ЗагрузитьНакладные" id="1">
			<Type>UsualButton</Type>
			<CommandName>Form.Command.ЗагрузитьНакладные</CommandName>
			<ExtendedTooltip name="ЗагрузитьНакладныеРасширеннаяПодсказка" id="2"/>
		</Button>
		<Button name="ВыгрузитьНоменклатуру" id="3">
			<Type>UsualButton</Type>
			<CommandName>Form.Command.ВыгрузитьНоменклатуру</CommandName>
			<ExtendedTooltip name="ВыгрузитьНоменклатуруРасширеннаяПодсказка" id="4"/>
		</Button>
	</ChildItems>
	<Attributes>
		<Attribute name="Объект" id="1">
			<Type>
				<v8:Type>cfg:ExternalDataProcessorObject.КНД_ЗагрузкаНакладныхСканер</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
		</Attribute>
		<Attribute name="ТокенПодключения" id="2">
			<Title>
				<v8:item><v8:lang>ru</v8:lang><v8:content>Токен подключения ScanFlow</v8:content></v8:item>
			</Title>
			<Type>
				<v8:Type>xs:string</v8:Type>
				<v8:StringQualifiers><v8:Length>255</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>
			</Type>
		</Attribute>
		<Attribute name="КодПодключения" id="3">
			<Title>
				<v8:item><v8:lang>ru</v8:lang><v8:content>Код подключения</v8:content></v8:item>
			</Title>
			<Type>
				<v8:Type>xs:string</v8:Type>
				<v8:StringQualifiers><v8:Length>20</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>
			</Type>
		</Attribute>
	</Attributes>
	<Commands>
		<Command name="ЗагрузитьНакладные" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Загрузить накладные</v8:content>
				</v8:item>
			</Title>
			<ToolTip>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Получить распознанные накладные со scan.magday.ru и создать документы Приходная накладная</v8:content>
				</v8:item>
			</ToolTip>
			<Action>ЗагрузитьНакладные</Action>
		</Command>
		<Command name="ВыгрузитьНоменклатуру" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Выгрузить номенклатуру</v8:content>
				</v8:item>
			</Title>
			<ToolTip>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Выгрузить справочник Номенклатура на scan.magday.ru</v8:content>
				</v8:item>
			</ToolTip>
			<Action>ВыгрузитьНоменклатуру</Action>
		</Command>
		<Command name="СохранитьПодключение" id="3">
			<Title>
				<v8:item><v8:lang>ru</v8:lang><v8:content>Сохранить подключение</v8:content></v8:item>
			</Title>
			<ToolTip>
				<v8:item><v8:lang>ru</v8:lang><v8:content>Сохранить отдельный токен подключения 1С из мастера ScanFlow</v8:content></v8:item>
			</ToolTip>
			<Action>СохранитьПодключение</Action>
		</Command>
		<Command name="ПодключитьПоКоду" id="4">
			<Title>
				<v8:item><v8:lang>ru</v8:lang><v8:content>Подключить</v8:content></v8:item>
			</Title>
			<ToolTip>
				<v8:item><v8:lang>ru</v8:lang><v8:content>Обменять код подключения из кабинета ScanFlow на постоянный токен</v8:content></v8:item>
			</ToolTip>
			<Action>ПодключитьПоКоду</Action>
		</Command>
	</Commands>
</form:Form>
